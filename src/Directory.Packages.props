<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Tasks.Git" Version="10.0.111" />
    <!-- MCP Server -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />

    <!-- Testing Framework -->
    <PackageVersion Include="TUnit" Version="1.84.0" />

    <!-- Build Tools -->
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="5.1.4" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="5.1.4" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="5.1.4" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
  </ItemGroup>
</Project>
